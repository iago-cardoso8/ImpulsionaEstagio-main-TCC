erDiagram
    USUARIOS ||--o{ VAGAS : "publica"
    USUARIOS ||--o| PERFIL : "possui"
    USUARIOS ||--o{ CANDIDATURAS : "envia"
    VAGAS ||--o{ CANDIDATURAS : "recebe"

    USUARIOS {
        int id PK
        string name
        string email UK
        string password_hash
        string role
        datetime created_at
        datetime updated_at
    }

    VAGAS {
        int id PK
        string title
        string company
        string location
        string email
        string time
        string type
        string salary
        string target
        string desc
        string requirements
        string benefits
        int usuario_id FK "nullable"
        datetime created_at
        datetime updated_at
    }

    PERFIL {
        int id PK
        string name
        string email
        string course
        string campus
        string status
        string availability
        int usuario_id FK "unique, nullable"
        datetime created_at
        datetime updated_at
    }

    CANDIDATURAS {
        int id PK
        int vaga_id FK
        int usuario_id FK
        string status
        string cover_letter
        datetime applied_at
        datetime updated_at
        string unique_vaga_usuario "vaga_id + usuario_id"
    }

    NOTIFICATIONS {
        int id PK
        string title
        string message
        string time
        datetime created_at
    }
