{
  "name": "impulsiona",
  "version": "2.0.0",
  "description": "Plataforma de oportunidades de estágio integrada com Prisma ORM",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node -r dotenv/config -r ts-node/register server.ts",
    "build": "tsc",
    "build:front": "tsc -p tsconfig.frontend.json",
    "dev": "node -r dotenv/config -r ts-node/register server.ts",
    "seed": "ts-node prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && npm run seed",
    "test": "node --test scripts/api_test.js",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/express": "^4.17.25",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.0.1",
    "prisma": "^5.22.0"
  }
}
