@baseUrl = http://localhost:3000
@timestamp = {{$timestamp}}

### Registrar empresa
# @name registerCompany
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Empresa HTTP",
  "email": "empresa-{{timestamp}}@example.com",
  "password": "senha1234",
  "role": "company"
}

### Registrar estudante
# @name registerStudent
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Estudante HTTP",
  "email": "estudante-{{timestamp}}@example.com",
  "password": "senha1234",
  "role": "student",
  "course": "Informática",
  "campus": "João Pessoa"
}

### Login empresa
# @name companyLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "empresa-{{timestamp}}@example.com",
  "password": "senha1234"
}

### Login estudante
# @name studentLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "estudante-{{timestamp}}@example.com",
  "password": "senha1234"
}

### Registrar segunda empresa para validar propriedade
# @name registerOtherCompany
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Outra Empresa HTTP",
  "email": "outra-empresa-{{timestamp}}@example.com",
  "password": "senha1234",
  "role": "company"
}

### Login segunda empresa
# @name otherCompanyLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "outra-empresa-{{timestamp}}@example.com",
  "password": "senha1234"
}

### Criar vaga como dona
# @name createJob
POST {{baseUrl}}/api/vagas
Authorization: Bearer {{companyLogin.response.body.token}}
Content-Type: application/json

{
  "title": "Estágio HTTP",
  "company": "Nome controlado pelo servidor",
  "location": "João Pessoa - PB",
  "email": "{{companyLogin.response.body.usuario.email}}",
  "salary": "R$ 900,00",
  "target": "Informática",
  "desc": "Vaga para validar os fluxos da API",
  "requirements": ["Conhecimentos básicos"],
  "benefits": ["Auxílio transporte"]
}

### Listar vagas
GET {{baseUrl}}/api/vagas

### Consultar vaga criada
GET {{baseUrl}}/api/vagas/{{createJob.response.body.dados.id}}

### Alterar vaga como dona
PUT {{baseUrl}}/api/vagas/{{createJob.response.body.dados.id}}
Authorization: Bearer {{companyLogin.response.body.token}}
Content-Type: application/json

{
  "title": "Estágio HTTP atualizado"
}

### Outra empresa não pode alterar vaga alheia (403)
PUT {{baseUrl}}/api/vagas/{{createJob.response.body.dados.id}}
Authorization: Bearer {{otherCompanyLogin.response.body.token}}
Content-Type: application/json

{
  "title": "Edição não autorizada"
}

### Estudante não pode criar vaga (403)
POST {{baseUrl}}/api/vagas
Authorization: Bearer {{studentLogin.response.body.token}}
Content-Type: application/json

{
  "title": "Vaga proibida",
  "company": "Estudante",
  "location": "João Pessoa - PB",
  "email": "estudante@example.com",
  "salary": "R$ 800,00",
  "target": "Informática"
}

### Buscar perfil do estudante
GET {{baseUrl}}/api/perfil
Authorization: Bearer {{studentLogin.response.body.token}}

### Atualizar perfil do estudante
PUT {{baseUrl}}/api/perfil
Authorization: Bearer {{studentLogin.response.body.token}}
Content-Type: application/json

{
  "name": "Estudante HTTP",
  "email": "estudante-{{timestamp}}@example.com",
  "course": "Informática",
  "campus": "João Pessoa",
  "status": "Disponível",
  "availability": "Integral"
}

### Listar notificações como empresa
GET {{baseUrl}}/api/notificacoes
Authorization: Bearer {{companyLogin.response.body.token}}

### Criar notificação como empresa
# @name createNotification
POST {{baseUrl}}/api/notificacoes
Authorization: Bearer {{companyLogin.response.body.token}}
Content-Type: application/json

{
  "title": "Notificação HTTP",
  "message": "Notificação criada para teste",
  "time": "Agora"
}

### Estudante não pode consultar notificações (403)
GET {{baseUrl}}/api/notificacoes
Authorization: Bearer {{studentLogin.response.body.token}}

### Candidatar estudante à vaga
# @name apply
POST {{baseUrl}}/api/vagas/{{createJob.response.body.dados.id}}/candidaturas
Authorization: Bearer {{studentLogin.response.body.token}}

### Listar minhas candidaturas
GET {{baseUrl}}/api/candidaturas/minhas
Authorization: Bearer {{studentLogin.response.body.token}}

### Empresa dona lista candidatos
GET {{baseUrl}}/api/vagas/{{createJob.response.body.dados.id}}/candidaturas
Authorization: Bearer {{companyLogin.response.body.token}}

### Empresa dona altera status
PATCH {{baseUrl}}/api/candidaturas/{{apply.response.body.dados.id}}/status
Authorization: Bearer {{companyLogin.response.body.token}}
Content-Type: application/json

{
  "status": "Aceito"
}

### Rota protegida sem token (401)
GET {{baseUrl}}/api/perfil

### Excluir vaga como dona
DELETE {{baseUrl}}/api/vagas/{{createJob.response.body.dados.id}}
Authorization: Bearer {{companyLogin.response.body.token}}
